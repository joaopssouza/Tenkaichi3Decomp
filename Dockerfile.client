FROM nginx:alpine

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy specialized Nginx config with COOP/COEP and Range support
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Create destination directory for client files
WORKDIR /usr/share/nginx/html

# Copy web frontend portal, runtime & assets
COPY port/web/index.html ./index.html
COPY port/web/runtime.html ./runtime.html
COPY port/web/app-shell.js ./app-shell.js
COPY port/web/app-shell.css ./app-shell.css
COPY port/web/shell.html ./shell.html
COPY port/web/web_pre.js ./web_pre.js
COPY port/web/net.js ./net.js
COPY port/web/net.css ./net.css
COPY port/web/manifest.webmanifest* ./manifest.webmanifest
COPY port/web/sw.js ./sw.js
COPY port/web/icon-*.png* ./

# Pre-create mount targets so Docker bind-mounts them as files/directories accurately
RUN touch ./disc.iso && mkdir -p ./build ./disc ./saves ./textures

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
